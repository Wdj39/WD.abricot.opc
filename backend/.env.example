# Copier ce fichier en .env puis renseigner les valeurs.

# Base de données SQLite (fichier créé par les migrations Prisma)
DATABASE_URL="file:./db.sqlite"

# Clé de signature des tokens JWT : remplacer par une longue chaîne aléatoire
JWT_SECRET=a_remplacer_par_une_longue_chaine_aleatoire

# Port de l'API
PORT=8000
