# Copier ce fichier en .env.local puis renseigner les valeurs.
# .env.local est ignoré par Git : ne jamais versionner de vraie clé.

# URL de l'API backend
API_URL=http://localhost:8000

# Fournisseur d'IA pour la génération de tâches : gemini (par défaut) ou mistral
AI_PROVIDER=gemini

# Clé du fournisseur choisi (une seule est nécessaire)
# Gemini : https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Mistral : https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# Facultatif : nom du modèle de chat (par défaut gemini-3.8-flash ou mistral-small-latest)
# À renseigner si le fournisseur retire le modèle par défaut
AI_MODEL=
